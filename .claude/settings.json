{
  "permissions": {
    "deny": [
      "Read(~/.schmoll-crossword/**)",
      "Edit(~/.schmoll-crossword/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Edit(**/.env)",
      "Edit(**/*.key)",
      "Bash(*schmoll-crossword*)",
      "Bash(*ANTHROPIC_API_KEY*)",
      "Bash(*.env*)",
      "PowerShell(*schmoll-crossword*)",
      "PowerShell(*ANTHROPIC_API_KEY*)",
      "PowerShell(*.env*)"
    ]
  }
}
